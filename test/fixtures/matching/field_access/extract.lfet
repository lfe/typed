(defmodule extract
  (export (get-value 1)))

(deftype/typed (wrapper t)
  (repr tagged-tuple)
  (Wrap (val t)))

(defun/typed get-value
  :args ((w wrapper))
  :returns integer
  :body (case/typed w
          ((Wrap v) v)))
