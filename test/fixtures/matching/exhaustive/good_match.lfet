(defmodule good_match
  (export (unwrap 1)))

(deftype/typed (result ok err)
  (repr tagged-tuple)
  (Ok    (value ok))
  (Error (reason err)))

(defun/typed unwrap
  :args ((r result))
  :returns integer
  :body (case/typed r
          ((Ok v) v)
          ((Error e) -1)))
