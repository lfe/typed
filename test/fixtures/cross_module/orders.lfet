(defmodule orders
  (export (status-label 1)
          (validate-order-status 2) (decode-order-status 1)
          (make-order 3) (order-id 1) (order-status 1) (order-total 1)
          (set-order-id 2) (set-order-status 2) (set-order-total 2)
          (validate-order 2) (decode-order 1)))

(deftype/typed order-status
  (repr tagged-tuple)
  (Pending)
  (Shipped (tracking string))
  (Cancelled (reason string)))

(defrecord/typed order
  (id integer)
  (status atom)
  (total integer))

(defun/typed status-label
  :args ((s order-status))
  :returns string
  :body (case/typed s
          ((Pending) "pending")
          ((Shipped t) (++ "shipped: " t))
          ((Cancelled r) (++ "cancelled: " r))))
