(defmodule membrane
  (export (describe 1)
          (validate-order-status 2)
          (decode-order-status 1)))

(deftype order-status
  (repr tagged-tuple)
  (Pending)
  (Shipped (tracking string))
  (Cancelled (reason string)))

(defun/typed describe
  :args ((s order-status))
  :returns string
  :body (case/typed s
          ((Pending) "queued")
          ((Shipped t) (++ "on its way: " t))
          ((Cancelled r) (++ "cancelled: " r))))
