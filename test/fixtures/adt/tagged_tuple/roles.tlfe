(defmodule roles
  (export (make-super 1) (make-regular 0)))

(deftype role
  (repr tagged-tuple)
  (SuperUser (level integer))
  (RegularUser))

(defun/typed make-super
  :args ((n integer))
  :returns role
  :body (SuperUser :level n))

(defun/typed make-regular
  :args ()
  :returns role
  :body (RegularUser))
