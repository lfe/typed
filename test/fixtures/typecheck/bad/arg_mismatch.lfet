;; typecheck/bad/arg_mismatch.tlfe
;; M3-4: calling a typed fn with wrong-typed arg.
;; 3
;; 4
;; 5
;; 6
;; 7
(defmodule arg_mismatch
  (export (double 1) (misuse 0)))

(defun/typed double
  :args ((x integer))
  :returns integer
  :body (+ x x))

(defun/typed misuse
  :args ()
  :returns integer
  :body (double "hello"))
