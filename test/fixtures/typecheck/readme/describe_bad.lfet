;; typecheck/readme/describe_bad.tlfe
;; C-4: README describe example — EXACT wrong version from README.
;; Matches on string patterns instead of constructors → rejected.
;; 4
;; 5
;; 6
;; 7
(defmodule describe_bad
  (export (describe 1)))

(deftype/typed order-status
  (repr tagged-tuple)
  (Pending)
  (Shipped (tracking string))
  (Cancelled (reason string)))

(defun/typed describe
  :args ((status order-status))
  :returns string
  :body (case/typed status
          ("pending" "queued")
          ("shipped" "on its way")
          ("cancelled" "nevermind")))
