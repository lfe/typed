(defmodule describe_good
  (export (describe 1)))

(deftype order-status
  (repr tagged-tuple)
  (Pending)
  (Shipped (tracking binary))
  (Delivered))

(defun/typed describe
  :args ((s order-status))
  :returns atom
  :body (case/typed s
          ((Pending) 'waiting)
          ((Shipped t) 'in-transit)
          ((Delivered) 'done)))
