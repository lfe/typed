(progn 
  (define-module predef-t1-corpus
    ()
    ((export
      (car-test 1)
      (caar-test 1)
      (cddr-test 1)
      (neq-test 2)
      (seq-test 2)
      (sneq-test 2)
      (list*-test 3)
      (let*-test 1)
      (flet*-test 1)
      (do-test 1)
      (fun-ref 0)
      (recv-test 0)
      (module-name 0)
      (colon-call 1)
      (flet-test 1)
      (fletrec-test 1)
      (add 2))))
  (define-macro MODULE () (match-lambda (((list) $ENV) `'predef-t1-corpus))))
(define-function car-test () (lambda (x) (car x)))
(define-function caar-test () (lambda (x) (car (car x))))
(define-function cddr-test () (lambda (x) (cdr (cdr x))))
(define-function neq-test () (lambda (a b) (!= a b)))
(define-function seq-test () (lambda (a b) (=== a b)))
(define-function sneq-test () (lambda (a b) (!== a b)))
(define-function list*-test () (lambda (a b c) (cons a (cons b c))))
(define-function let*-test
  ()
  (lambda (x) (let ((a (+ x 1))) (let ((b (* a 2))) (progn b)))))
(define-function flet*-test
  ()
  (lambda (x)
    (let-function ((add1 (lambda (n) (+ n 1))))
      (let-function ((dbl (lambda (n) (* n 2)))) (progn (dbl (add1 x)))))))
(define-function do-test
  ()
  (lambda (n)
    (letrec-function ((do$^0
                       (lambda (i acc)
                         (if (== i n)
                           acc
                           (let ((do-state (progn)))
                             (do$^0 (+ i 1) (+ acc i)))))))
      (do$^0 0 0))))
(define-function fun-ref
  ()
  (lambda () (lambda (|\|-0-\||) (call 'lists 'reverse |\|-0-\||))))
(define-function recv-test
  ()
  (lambda () (receive (omega omega) (after 1000 'timeout))))
(define-function module-name () (lambda () 'predef-t1-corpus))
(define-function colon-call () (lambda (x) (call 'erlang 'atom_to_list x)))
(define-macro my-const () (match-lambda (((list) $ENV) `42)))
(define-function flet-test
  ()
  (lambda (x) (let-function ((helper (lambda (n) (+ n 1)))) (helper x))))
(define-function fletrec-test
  ()
  (lambda (n)
    (letrec-function ((loop
                       (lambda (i acc)
                         (if (== i 0) acc (loop (- i 1) (+ acc i))))))
      (loop n 0))))
(define-type (my-type) ())
(define-function-spec (add 1) (((integer) (integer)) integer))
(define-function add () (lambda (a b) (+ a b)))
